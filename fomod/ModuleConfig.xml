<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>BodyHairSliders @VERSION@</moduleName>
  <requiredInstallFiles>
    <folder source="00 Core" destination="" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Body hair overlay packs">
      <optionalFileGroups order="Explicit">
        <group name="Select the body-hair packs you have installed" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="Nordic Warmaiden Body Hair">
              <description>Enables female pubic, armpit, stomach, butt and back styles from Nordic Warmaiden Body Hair.</description>
              <files>
                <folder source="10 Nordic Warmaiden" destination="" priority="10" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="Nordic Warmaiden Body Hair.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="HIMBO V3 Bodyhair Overlays for Racemenu">
              <description>Enables male arm, hand, armpit, butt, back, stomach, chest, leg and foot hair overlays from the HIMBO body-hair pack.</description>
              <files>
                <folder source="20 HIMBO" destination="" priority="20" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="HIMBOBodyhairOverlay.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Pubes Forever Female / Pubic Hairstyles All In One CBBE">
              <description>Enables the female pubic-hair overlays supplied by Pubes Forever Female / Pubic Hairstyles All In One CBBE.</description>
              <files>
                <folder source="30 Pubes Forever Female" destination="" priority="30" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="AK_RM_PubicStyles_All_In_One.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="Pubes Forever Male">
              <description>Enables the male pubic-hair overlays supplied by Pubes Forever for Males.</description>
              <files>
                <folder source="40 Pubes Forever Male" destination="" priority="40" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="AK_RM_PubicStyles_All_In_One_M.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
            <plugin name="OPubes NG compatibility">
              <description>Installs the OPubes NG compatibility provider. Keep OPubes itself installed; BodyHairSliders does not redistribute its assets.</description>
              <files>
                <folder source="50 OPubes" destination="" priority="50" />
              </files>
              <typeDescriptor>
                <dependencyType>
                  <defaultType name="Optional" />
                  <patterns>
                    <pattern>
                      <dependencies operator="And">
                        <fileDependency file="OPubes.esp" state="Active" />
                      </dependencies>
                      <type name="Recommended" />
                    </pattern>
                  </patterns>
                </dependencyType>
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
